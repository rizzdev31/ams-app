# ==============================================================================
# AN-NUR MINI SOCCER - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Salin file ini menjadi .env.local dan sesuaikan nilainya:
# cp .env.example .env.local

# ------------------------------------------------------------------------------
# 1. Konfigurasi Database (MySQL / Hostinger / Localhost XAMPP)
# ------------------------------------------------------------------------------
# Driver database yang aktif: 'mysql' (default untuk Hostinger & XAMPP) atau 'supabase'
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_annur
DB_PASSWORD=PasswordDatabaseHostingerAnda
DB_NAME=u123456789_annur_minsoc

# ------------------------------------------------------------------------------
# 2. Konfigurasi Supabase (Opsional / Fallback bila DB_DRIVER=supabase)
# ------------------------------------------------------------------------------
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Keamanan & Autentikasi Admin
# ------------------------------------------------------------------------------
# Password bootstrap akun superadmin default saat login pertama
ADMIN_PASSWORD=ganti_dengan_password_admin_yang_kuat

# Secret key untuk signing JWT sesi admin (WAJIB minimal 32 karakter)
SESSION_SECRET=ganti_dengan_string_acak_minimal_32_karakter_contoh_1234567890abcdef
